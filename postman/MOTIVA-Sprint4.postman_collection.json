      "name": "Trechos",
      "item": [
        {
          "name": "01 - Listar trechos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/trechos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Criar trecho",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/trechos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"km\": 10,\n  \"crescimentoVegetacao\": 85,\n  \"tipoTrecho\": \"umido\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('trechoId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Buscar trecho criado",
